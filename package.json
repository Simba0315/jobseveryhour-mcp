    "entry-level-jobs",
    "salaries"
  ],
  "homepage": "https://jobseveryhour.com/api/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Simba0315/jobseveryhour-mcp.git"
  },
  "license": "MIT",
