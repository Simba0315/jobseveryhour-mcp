{
  "name": "jobseveryhour-mcp",
  "version": "1.0.2",
  "description": "MCP server for open jobs in every field, mostly in the US, read from employers' own career pages and rechecked around the clock (Jobs Every Hour's free API, no key)",
  "type": "module",
  "bin": {
    "jobseveryhour-mcp": "index.js"
  },
  "main": "index.js",
